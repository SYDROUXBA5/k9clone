# Copy to .env and fill in. Never commit .env.
# App identity (placeholder until Rémi picks a name — see docs/DECISIONS.md #1)
EXPO_PUBLIC_APP_NAME=K9CLONE

# Data mode: "local" (demo, everything stored on this device — no account needed)
#            "supabase" (hosted backend; requires the two keys below)
EXPO_PUBLIC_DATA_MODE=local

# Supabase (hosted, US-East). Create the project following docs/SETUP.md, then paste:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Email for the one required notification (reject → handler). Server-side only (Edge Function).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
